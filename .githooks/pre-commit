#!/usr/bin/env python3
"""Native git pre-commit hook: blocks committing directly to main/master.

This replaces .claude/hooks/block-main-commit.py and the whole
_git_commit_detect.py shell-text-parsing apparatus it depended on. That
approach tried to detect "does this Bash command invoke git commit" by
parsing the command string before it reached git — an unbounded problem,
since shell syntax has no finite enumeration (operators, wrapper
commands, subshells, command substitution, brace grouping, conditionals
all had to be discovered and patched one at a time, across two PRs and
twenty-plus review rounds, and a review pass still found four more
complete bypasses — backticks, $(...), braces, and conditionals — after
all of that).

This hook has none of that problem, because it isn't intercepting a
shell command at all. Git invokes this script directly, from inside its
own commit machinery, after git and the shell have already finished
parsing however the user or agent actually wrote the command — bare
`git commit`, an alias, a shell function, backticks, $(...), a
conditional, sudo, a script, anything. There is no text to parse and
therefore no alphabet of shell syntax this can fail to recognize.

Requires `git config core.hooksPath .githooks` to be set for this repo
(see the SessionStart hook in .claude/settings.json, which sets this
automatically at the start of every Claude Code session working in this
repo — a plain git clone without that step won't have this hook wired
up, since .git/hooks/ itself is never version-controlled)."""
import subprocess
import sys


def main():
    try:
        result = subprocess.run(
            ["git", "symbolic-ref", "--short", "HEAD"],
            capture_output=True, text=True, check=True,
        )
    except subprocess.CalledProcessError:
        return 0  # detached HEAD or similarly unusual state — not this hook's job to handle

    branch = result.stdout.strip()
    if branch in ("main", "master"):
        print(f"Blocked: direct commit to '{branch}' isn't allowed in this repo.", file=sys.stderr)
        print("Create/switch to a feature branch first, e.g.: git checkout -b <type>/<slug> (type: feat/fix/docs/chore — see CLAUDE.md)", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
